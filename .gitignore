# ── Secrets — never commit ──────────────────────────────────────────────
# Each bot's .env holds live Alpaca keys; cdp_api_key.json is a Coinbase
# ES256 private key; alpacarecovery.txt is an account recovery credential.
.env
.env.*
!.env.example
cdp_api_key.json
alpacarecovery.txt
*.pem
*.p8
*.key

# ── Dependencies ────────────────────────────────────────────────────────
node_modules/

# ── Claude Code worktrees — separate checkouts, not part of this tree ───
.claude/worktrees/

# ── Runtime state — rewritten every cycle, meaningless in history ───────
# Archived bots are frozen, so their final state IS evidence — keep those.
position.json
stock-state*.json
safety-check-log.json
!archive/**/position.json
!archive/**/safety-check-log.json
.bar-cache/

# ── Logs ────────────────────────────────────────────────────────────────
# Live bot logs churn constantly. The archived Bot A run is frozen evidence
# behind POSTMORTEM-BOT-A.md, so that one is kept.
*.log
!archive/**/*.log

# ── Cached historical candles — large and re-downloadable ───────────────
backtest/data/

# ── OS noise ────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
