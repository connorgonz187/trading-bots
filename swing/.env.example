# Bot E -- swing. Copy to .env and fill in:  Copy-Item .env.example .env
# .env is gitignored -- never commit it.
#
# ============================================================================
# ACCOUNT -- THIS MUST BE ITS OWN ALPACA PAPER ACCOUNT
# ============================================================================
# Bot E holds positions overnight. Bots B and C sweep ANY position still open at
# the first cycle of a new session (the "stranded-position sweep" that exists
# because one missed flatten cost -$355.67). Point Bot E at B's or C's account
# and they will close its swings at the next open, silently, every time.
#
# Create a THIRD paper account: app.alpaca.markets -> Paper Trading -> generate
# new keys. Verify with:  node swingbot.js --check-auth
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_URL=https://data.alpaca.markets

BOT_NAME=Bot E
BOT_TAG=E

# ============================================================================
# THE BRIEF: cap losses at 1-2%, let winners reach 4-7%
# ============================================================================
SWING_STOP_PCT=2.0                 # 1.0-2.0. See SWING_MIN_STOP_ATR below --
                                   # these two knobs are coupled and must move
                                   # together or the stop becomes meaningless.
SWING_TARGET_PCT=5.0               # 4.0-7.0. 5.0 with a 2.0 stop = 2.5:1,
                                   # which breaks even at a 28.6% win rate.

# Breakeven ratchet -- the lever that turns would-be losers into scratches.
# Once the trade closes SWING_BREAKEVEN_AT_PCT in your favour, the resting stop
# is raised to entry + offset and the trade can no longer lose.
SWING_BREAKEVEN=true
SWING_BREAKEVEN_AT_PCT=3.0         # keep past halfway to target, or you will
                                   # scratch the runners this bot exists to find
SWING_BREAKEVEN_OFFSET_PCT=0.1
SWING_RATCHET_ON=close             # close | high. "close" needs a SUSTAINED
                                   # move before tightening; "high" tightens on
                                   # an intraday wick (safer, cuts more winners)
SWING_TRAIL_ATR_MULT=0             # >0 adds an ATR trail AFTER breakeven. Left
                                   # off so the test measures the stated rules.

SWING_MAX_HOLD_DAYS=10             # dead-money exit, in trading days

# ============================================================================
# THE COUPLING THAT MAKES A TIGHT STOP WORK
# ============================================================================
# A 2% stop on a name with 5% daily ATR is not a stop, it is a coin flip. The
# scanner refuses any symbol where the stop is not at least MIN_STOP_ATR times
# the daily ATR. With STOP_PCT=2.0 and MIN_STOP_ATR=0.8 that admits names up to
# 2.5% ATR. Lower this only if you also widen the stop.
SWING_MIN_STOP_ATR=0.8
SWING_ATR_LEN=14

# ============================================================================
# ENTRY
# ============================================================================
SWING_TRIGGER=pullback             # pullback | breakout
                                   # pullback: RSI(2) oversold inside an uptrend,
                                   #   then a close above the prior bar's high.
                                   #   Entry sits near a swing low, so a tight
                                   #   stop has a real level under it.
                                   # breakout: close above the 20-day high.
                                   #   Included for comparison; a 2% stop under
                                   #   a breakout is an arbitrary line in air.
SWING_FAST_LEN=20
SWING_SLOW_LEN=50
SWING_RSI_LEN=2
SWING_RSI_LONG_ENTRY=15
SWING_RSI_SHORT_ENTRY=85
SWING_BREAKOUT_LEN=20
SWING_MAX_EXT_PCT=4.0              # do not chase more than this far from SMA20

SWING_LONGS=true
SWING_SHORTS=true
SWING_REGIME=true                  # longs only above SPY's SMA50, shorts below.
SWING_REGIME_SYMBOL=SPY            # Outside the band below only one sleeve can
SWING_REGIME_LEN=50                # fire on a given day, which keeps long/short
                                   # attribution clean inside ONE account
                                   # (post-mortem lesson 4).
SWING_REGIME_BAND_PCT=0            # half-width of a NEUTRAL zone around the SMA, percent.
                                   # Inside it the LONG veto is lifted (shorts still need a
                                   # decisively bear tape). DEFAULT 0 = OFF, and that is a
                                   # measurement: on 2026-07-28 SPY closed 0.54% under its
                                   # SMA50, every long was blocked and only 3 of 23 names were
                                   # themselves in downtrends -> a zero-trade day. But over 3y
                                   # the cure costs more than the disease, because the longs a
                                   # band admits are taken with SPY below its own average and
                                   # are worse than the average long:
                                   #   band 0 -> exp +0.012R | 1.0 -> +0.000R | 1.5 -> -0.020R
                                   # Re-run `node swing-bt.js 1095` before enabling it.
                                   #
                                   # The big lever is SWING_SHORTS, not this: shorts=false
                                   # tests at +0.035R / PF 1.06 vs +0.012R / PF 1.02, and is
                                   # positive in 3 of 4 years instead of 2.

# ============================================================================
# UNIVERSE (swing-scan.js)
# ============================================================================
SWING_MIN_PRICE=10
SWING_MAX_PRICE=1200               # high enough to admit SPY / QQQ / COST. A
                                   # $600 cap silently rejected the three
                                   # calmest, most liquid names in the universe.
SWING_MIN_DOLLAR_VOL=50000000      # 20-day average dollar volume ON THE IEX
                                   # FEED, which sees roughly a twentieth of
                                   # consolidated tape. This is a relative
                                   # liquidity rank, not $50M of real turnover.
SWING_TOP=25
SWING_INCLUDE_ACTIVES=true         # add most-actives to the core list (still
                                   # subject to every gate above)
# SWING_UNIVERSE=AAPL,MSFT,...     # override the built-in core list entirely.
                                   # Set the SAME value here and for swing-bt.js
                                   # or the backtest and the live bot are not
                                   # measuring the same thing.

# ============================================================================
# SIZING AND RISK
# ============================================================================
SWING_RISK_USD=100                 # dollars risked per trade (entry -> stop)
SWING_MAX_NOTIONAL=10000           # per-position cap
SWING_MAX_POSITIONS=5
SWING_MAX_PER_SECTOR=2             # five semis names are one bet, not five
SWING_MAX_OPEN_RISK_USD=500        # total risk across the open book

# ============================================================================
# SCHEDULE
# ============================================================================
# Entries are decided once a day, late, off daily bars. The free IEX feed is
# ~15 min delayed; at 15:40 you are acting on ~15:25 prices, which matters far
# less for a multi-day hold than it did for the 5-minute ORB entries.
SWING_ENTRY_START=940              # 15:40 ET, in minutes past midnight
SWING_ENTRY_END=955                # 15:55 ET
SWING_WATCHLIST_MAX_AGE_DAYS=5     # refuse to trade off a staler watchlist

# ============================================================================
# FILES
# ============================================================================
SWING_STATE=swing-state.json
SWING_TRADELOG=swing-trades.csv
SWING_WATCHLIST=swing-watchlist.csv

# ============================================================================
# BACKTEST
# ============================================================================
SWING_BT_SLIPPAGE_BPS=5            # cost per side, applied twice per trade

# ============================================================================
# NOTIFICATIONS (optional -- the bot runs fine without them)
# ============================================================================
# @BotFather -> /newbot -> token; then message the bot and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# NETWORK
# ============================================================================
APCA_RETRIES=3
APCA_RETRY_MS=800
