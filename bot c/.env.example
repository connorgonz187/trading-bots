# Copy this to .env and fill in your values:  Copy-Item .env.example .env
# .env is gitignored â€” never commit it.

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# CRYPTO BOT â€” bot.js  (Coinbase Advanced, donchian daily breakout, PAPER)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

BOT_NAME=Bot A                     # label shown at the start of every SMS text
SYMBOL=BTC-USD
TIMEFRAME=1D                       # donchian is a daily-breakout strategy
PAPER_TRADING=true                 # logs decisions, never places real orders

# Strategy module to load (any file under strategies/). Default is donchian.
STRATEGY=strategies/donchian.js
# donchian knobs (optional): entry = break of N-day high, exit = M-day low or ATRx stop
DON_N=55
DON_M=20
DON_ATRX=3

# â”€â”€ Coinbase Advanced credentials â”€â”€
# Easiest: point at the downloaded key JSON (cdp_api_key.json) and the bot reads
# the name + EC private key straight from it (no PEM pasting). Use an ABSOLUTE path.
COINBASE_KEY_FILE=<path to>\cdp_api_key.json
# Alternative to COINBASE_KEY_FILE â€” paste them inline instead:
#   COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
#   COINBASE_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMHcC...\n-----END EC PRIVATE KEY-----\n
# Create the key at advanced.coinbase.com -> Settings -> API.
# Permissions: View + Trade. Withdrawals: OFF. IP allowlist: ON (this machine's IP).

# Live-order safety latch. Leave BLANK to keep orders stubbed. To send real
# Coinbase orders you must set BOTH PAPER_TRADING=false AND this to exactly:
#   COINBASE_LIVE_CONFIRM=I_UNDERSTAND
COINBASE_LIVE_CONFIRM=

# Guardrails
PORTFOLIO_VALUE_USD=1000
MAX_TRADE_SIZE_USD=50              # hard cap per trade
MAX_TRADES_PER_DAY=3

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STOCK BOT â€” scan.js + stockbot.js  (Alpaca, Opening-Range Breakout, PAPER)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# Alpaca PAPER account (app.alpaca.markets -> Paper Trading -> API Keys)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_URL=https://data.alpaca.markets

# scan.js â€” pre-market universe filter -> watchlist.csv
SCAN_MIN_PRICE=5
SCAN_MAX_PRICE=500
SCAN_MIN_VOLUME=1000000
SCAN_MIN_VOLATILITY=3             # % â€” drops dead names
SCAN_MAX_PRIOR_MOVE=15           # % â€” skip already-exhausted movers (0 = off)
SCAN_TOP=8

# stockbot.js â€” ORB execution
ORB_MINUTES=15                    # opening-range window length
ORB_R=1                          # target = entry + R * (entry - OR low)
ORB_LAST_ENTRY=15:30             # ET â€” no new entries after this
STOCK_RISK_USD=50                # $ risked per trade (drives position size)
STOCK_MAX_NOTIONAL=2000          # cap per position, fixed $
STOCK_MAX_NOTIONAL_PCT=7         # cap per position, % of account equity. The
                                 # SMALLER of this and STOCK_MAX_NOTIONAL wins.
                                 # 0 disables. If the account can't be read the
                                 # bot takes NO new entries that cycle.
STOCK_MIN_RISK_FRAC=0.5          # skip trades the notional cap shrinks below this Ã— RISK_USD

# stockbot.js â€” direction / exit variants (account B/C flip these)
# ORB_LONGS=true                 # take long breakouts (default on)
# ORB_SHORTS=false               # also short breakdowns below the OR low
# ORB_TRAILING=false             # exit via trailing stop instead of fixed R target
# ORB_TRAIL_ATR_MULT=2           # trailing distance = this Ã— ATR(14, 5min)...
# ORB_TRAIL_MIN_PCT=1            # ...with a floor of this % of price (no penny trails)
# ORB_TRAIL_PRICE=               # or force a fixed $ trail distance

# stockbot.js â€” risk controls (all on by default; tune or disable per account)
ORB_REGIME=true                  # longs only when SPYâ‰¥VWAP, shorts only when SPYâ‰¤VWAP
ORB_REGIME_SYMBOL=SPY            # tape proxy for the regime filter
ORB_MAX_POSITIONS=4              # cap concurrent open positions
ORB_MAX_PER_SECTOR=2             # cap positions in one correlated cluster (e.g. semis)
ORB_MAX_DAILY_LOSS=150           # halt new entries once realized P/L â‰¤ âˆ’this

# Shared bar cache â€” all accounts in a 5-min cycle read identical data (comparable
# signals instead of per-process noise). Relative to each bot folder.
SHARED_BAR_CACHE=../.bar-cache

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# BACKTESTING â€” bt.js / backtest.js / sweep.js
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
BACKTEST_FEE_PCT=0.6             # assumed fee per side (Coinbase taker ~0.6%; stocks ~0.02)

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TELEGRAM ALERTS â€” notify.js  (real-time on order placed / error; silent otherwise)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# Setup (one time, shared by all 3 bots):
#   1. Telegram -> @BotFather -> /newbot -> copy the token.
#   2. Send your new bot any message so it has a chat with you.
#   3. https://api.telegram.org/bot<TOKEN>/getUpdates -> copy message.chat.id
# Leave blank to disable alerts entirely (the bot still trades).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
